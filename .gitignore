# Contents, not the directory: git never re-includes a file under an excluded
# directory, and the step lists below are tracked.
**/.claude/*
!/.claude/planwright.yml
mise.local.toml
# planwright's per-spec orchestration runtime state (dispatch markers, lock).
# Runtime, never tracked: every /orchestrate run would otherwise leave the
# working tree dirty.
specs/*/.orchestrate/
