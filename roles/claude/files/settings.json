{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/path-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/worker-guard-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/worktree-bootstrap.sh"
          }
        ]
      }
    ],
    "Stop": [],
    "Notification": [],
    "SubagentStop": []
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "planwright@planwright": true
  },
  "alwaysThinkingEnabled": true,
  "outputStyle": "compact",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash($HOME/.claude/plugins/cache/planwright/planwright/*/scripts/fleet-streamjson.sh answer *)",
      "Bash($HOME/.claude/plugins/cache/planwright/planwright/*/scripts/fleet-streamjson.sh pending *)",
      "Bash($HOME/.claude/plugins/cache/planwright/planwright/*/scripts/mc-reclaim.sh reclaim *)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(ssh -o BatchMode=yes -o ConnectTimeout=10 planwright-relay 'tmux load-buffer - && tmux paste-buffer -t %570 && sleep 1 && tmux send-keys -t %570 Enter')",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tmux kill-pane -t %*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(tmux kill-pane -t %* -*)",
      "Bash(tmux kill-pane *;*)"
    ]
  }
}
