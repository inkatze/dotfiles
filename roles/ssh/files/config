Include ~/.colima/ssh_config

# Machine-local host aliases: LAN hosts (internal hostnames, RFC1918 addresses,
# per-host user/forwarding settings). Deliberately NOT tracked — this repo is
# public and REQ-F1.1 keeps LAN topology out of committed artifacts. Included
# first so machine-local host blocks win (ssh_config is first-value-wins).
# A missing include file is not an error.
Include ~/.ssh/config.local

Host *
    # UseKeychain is macOS-only and is an *unknown keyword* to Linux OpenSSH,
    # which rejects it at parse time ("Bad configuration option: usekeychain",
    # exit 255) — that kills every ssh and git-over-ssh call, and no Match
    # guard prevents it, because parsing happens regardless of whether the
    # block matches. IgnoreUnknown is the supported cross-platform mechanism
    # and must appear before the keyword it covers.
    IgnoreUnknown UseKeychain
    UseKeychain yes
    ServerAliveInterval 60
    TCPKeepAlive yes
    StrictHostKeyChecking no
    AddKeysToAgent yes
    ControlPath ~/.ssh/sockets/master-%r@%h:%p
    ControlPersist 12h
    # Machine-local file FIRST: ssh appends newly accepted host keys to the
    # first file in this list. That keeps LAN host identities and fingerprints
    # out of the repo (REQ-F1.1) and stops StrictHostKeyChecking=no from
    # silently dirtying the dotfiles checkout, which ~/.ssh/known_hosts
    # symlinks into. The tracked file stays the read-only pin set for public
    # hosts.
    UserKnownHostsFile ~/.ssh/known_hosts.local ~/.ssh/known_hosts

# Use 1Password agent socket when:
# - Not in an interactive SSH session (SSH_TTY unset)
# - SSH_AUTH_SOCK is unset OR points to macOS keychain (com.apple.launchd)
# - Running on macOS (Darwin)
# - 1Password socket exists
# This ensures we use 1Password locally (overriding macOS keychain), but respect
# forwarded agents when SSH_AUTH_SOCK is set and doesn't point to macOS keychain
Match host * exec "sh -c 'test -z \"$SSH_TTY\" && uname | grep -q Darwin && test -S ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock && (test -z \"$SSH_AUTH_SOCK\" || echo \"$SSH_AUTH_SOCK\" | grep -q \"com.apple.launchd\")'"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Same intent on Linux, where 1Password's agent socket lives at
# ~/.1password/agent.sock. Without this the migrated host silently loses the
# 1Password agent the moment Ansible symlinks this file over a hand-written
# config, falling back to whatever SSH_AUTH_SOCK points at (gnome-keyring),
# which does not hold the keys used for auth and commit signing.
Match host * exec "sh -c 'test -z \"$SSH_TTY\" && uname | grep -q Linux && test -S ~/.1password/agent.sock'"
    IdentityAgent ~/.1password/agent.sock

# LAN host aliases live in ~/.ssh/config.local (see the Include above), not
# here. See roles/ssh/README.md for the template.

Host rfh.rsync.net
    Hostname usw-s004.rsync.net
    User 40377
